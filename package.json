{
  "name": "@jjg0/twizen",
  "version": "0.7.4",
  "description": "Twitch player for Samsung Tizen TVs (TizenBrew module)",
  "packageType": "app",
  "appName": "Twizen DE",
  "appPath": "app/index.html",
  "serviceFile": "service/service.js",
  "keys": [
    "MediaPlayPause",
    "MediaPlay",
    "MediaPause",
    "MediaStop",
    "ColorF0Red",
    "ColorF1Green",
    "ColorF2Yellow",
    "ColorF3Blue",
    "ChannelUp",
    "ChannelDown",
    "MediaRewind",
    "MediaFastForward"
  ],
  "scripts": {
    "build": "node tools/build.js",
    "prepublishOnly": "node tools/build.js"
  },
  "files": [
    "app/index.html",
    "app/css",
    "app/vendor",
    "app/twizen.js",
    "service",
    "README.md"
  ],
  "keywords": [
    "tizenbrew",
    "tizen",
    "twitch",
    "adblock"
  ],
  "license": "MIT"
}
